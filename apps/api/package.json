{
  "name": "express-api",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "tsx --conditions=development --watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:dev": "prisma migrate dev",
    "prisma:create": "npx prisma migrate dev --create-only",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format --schema=./prisma/models",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio --port 5555 --browser none",
    "prisma:push": "prisma db push",
    "prisma:pull": "prisma db pull",
    "prisma:seed": "prisma db seed"
  },
  "keywords": [],
  "author": "Oshchenkov",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@repo/shared-types": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "argon2": "^0.44.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.4",
    "morgan": "^1.11.0",
    "pg": "^8.21.0",
    "rate-limit-redis": "^5.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^6.0.2",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.2",
    "@types/pg": "^8.20.0",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.9.0"
  },
  "imports": {
    "#src/*": {
      "development": "./src/*.ts",
      "default": "./dist/src/*.js"
    },
    "#root/*": {
      "development": "./*.ts",
      "default": "./dist/*.js"
    }
  }
}
