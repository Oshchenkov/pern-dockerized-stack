{
  "name": "express-api",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "tsx --conditions=development --watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "studio": "prisma studio --port 5555 --browser none"
  },
  "keywords": [],
  "author": "Oshchenkov",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@repo/shared-types": "workspace:*",
    "argon2": "^0.44.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "rate-limit-redis": "^5.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.2",
    "@types/pg": "^8.20.0",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.9.0"
  },
  "imports": {
    "#src/*": {
      "development": "./src/*.ts",
      "default": "./dist/src/*.js"
    },
    "#root/*": {
      "development": "./*.ts",
      "default": "./dist/*.js"
    }
  }
}
