# =============================================================================
# .env.example — copy to .env and fill in real values
# NEVER commit .env to version control
# =============================================================================

# ----- PostgreSQL -----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=app
POSTGRES_PORT=5432          # host-side port exposed in dev only

DATABASE_URL=postgres://postgres:changeme@db:5432/app #combined connection string from varpostgres://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB:-app} for Prisma, pgAdmin, etc.

# ----- Redis -----
REDIS_PORT=6379
REDIS_PASSWORD=changeme
REDIS_URL=redis://redis:6379

# ----- API / Express -----
API_PROTOCOL=https:
API_HOSTNAME=localhost
API_PORT=4000


# ----- Client -----
CLIENT_PROTOCOL=https:
CLIENT_HOSTNAME=localhost
CLIENT_PORT=3000


# ----- pgAdmin (dev only) -----
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ----- Admin / TanStack Router -----
ADMIN_PORT=5000

# ----- JWT -----

# For HS256 monolith:
JWT_SECRET=at-least-32-bytes-random-secret

# For RS256/EdDSA, use private/public keys instead.
JWT_ISSUER=http://localhost:4000
JWT_AUDIENCE=http://localhost:4000

# 5min
ACCESS_TOKEN_TTL_SECONDS=300
# 7d
REFRESH_TOKEN_TTL_SECONDS=604800

JWT_ACCESS_SECRET=at-least-32-bytes-random-secretat-least-32-bytes-random-secretat-least-32-bytes-random-secretat-least-32-bytes-random-secret
JWT_REFRESH_SECRET=at-least-32-bytes-random-secretat-least-32-bytes-random-secretat-least-32-bytes-random-secretat-least-32-bytes-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

CORS_ORIGIN=http://localhost:4000,http://localhost:3000

COOKIE_DOMAIN=localhost
COOKIE_SECURE=true
AUTH_RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX_REQUESTS=100
