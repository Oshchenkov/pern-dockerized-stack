# =============================================================================
# .env.example — copy to .env and fill in real values
# NEVER commit .env to version control
# =============================================================================

# ----- PostgreSQL -----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=app
POSTGRES_PORT=5432          # host-side port exposed in dev only

DATABASE_URL=postgres://postgres:changeme@db:5432/app #combined connection string from varpostgres://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB:-app} for Prisma, pgAdmin, etc.

# ----- Redis -----
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ----- API / Express -----
API_PORT=4000
NODE_ENV=development        # overridden to "production" in prod compose

# ----- React / Next -----
CLIENT_PORT=3000
API_URL=http://localhost:4000

# ----- pgAdmin (dev only) -----
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ----- Admin / TanStack Router -----
ADMIN_PORT=5000
